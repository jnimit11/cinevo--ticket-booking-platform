# ==============================================================================
# Cinevo Backend Environment Variables (.env.example)
# Copy this file to backend/.env and replace placeholders with your actual values.
# DO NOT commit backend/.env to version control.
# ==============================================================================

# Server Port (optional, defaults to 5000)
PORT=5000

# PostgreSQL Connection String (required)
# Matches docker-compose.yml defaults (database: cinevo, user: cinevo_user, port: 5432)
# Replace <POSTGRES_PASSWORD> with the password configured in root .env.
# If your password contains reserved URL characters (e.g., @, :, /, ?, #, %),
# percent-encode them (e.g. encodeURIComponent) to ensure valid URL parsing.
DATABASE_URL=postgresql://cinevo_user:<POSTGRES_PASSWORD>@localhost:5432/cinevo

# JWT Authentication Secret (required)
# Provide a secure random secret key (minimum 32 characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# JWT Expiration Duration (optional, defaults to "1d")
# Supported formats: "1d", "7d", "2h", "30m"
JWT_EXPIRES_IN=1d
